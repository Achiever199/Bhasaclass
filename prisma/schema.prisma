generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(cuid())
  googleId           String?         @unique
  name               String?
  email              String          @unique
  emailVerified      DateTime?
  image              String?
  avatarUrl          String?
  hasOnboarded       Boolean         @default(false)
  onboardingStep     Int             @default(1)
  preferredUiLanguage String          @default("en")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  accounts           Account[]
  sessions           Session[]
  resources          Resource[]
  drafts             Draft[]
  usageEvents        ResourceUsage[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model SourceLesson {
  id        String     @id @default(cuid())
  title     String
  grade     Int
  subject   String
  bodyText  String     @db.Text
  sourceUrl String
  license   String
  createdAt DateTime   @default(now())
  resources Resource[]
  @@index([grade, subject])
}

model Resource {
  id                String          @id @default(cuid())
  title             String
  grade             Int
  subject           String
  targetLanguage    String
  resourceType      String
  learningObjective String
  sourceLessonId    String?
  authorId          String
  content           Json
  localizedNotes    Json
  qualityChecks     Json
  verified          Boolean         @default(false)
  published         Boolean         @default(false)
  editedBeforePublish Boolean       @default(false)
  duplicatedFromId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  author            User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sourceLesson      SourceLesson?   @relation(fields: [sourceLessonId], references: [id], onDelete: SetNull)
  usageEvents       ResourceUsage[]
  @@index([authorId, updatedAt])
  @@index([published, verified, updatedAt])
  @@index([targetLanguage])
}

model ResourceUsage {
  id         String   @id @default(cuid())
  resourceId String
  userId     String?
  action     String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([resourceId, action])
  @@index([userId, createdAt])
}

model Draft {
  id        String   @id @default(cuid())
  userId    String
  step      Int      @default(1)
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, updatedAt])
}
